# DriveLocal - Configuração de Ambiente
# Copie este arquivo para .env e configure suas variáveis
# 
# IMPORTANTE: O arquivo .env não deve ser commitado no git!
# Ele contém informações sensíveis como senhas.

# ============================================
# AUTENTICAÇÃO
# ============================================
# Autenticação está habilitada por padrão
# Para desabilitar, defina como false (não recomendado)
AUTH_ENABLED=true

# Tipo de autenticação: 'token' ou 'basic'
# Token é mais flexível e recomendado
AUTH_TYPE=token

# Credenciais de acesso
# ⚠️ ALTERE ESTAS CREDENCIAIS EM PRODUÇÃO!
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# ============================================
# SERVIDOR
# ============================================
# Porta do servidor
PORT=80

# ============================================
# MÍDIA
# ============================================
# Caminho para a pasta de mídia (relativo ou absoluto)
# Windows: C:\\Videos
# Linux/Mac: /media/videos
MEDIA_PATH=./media

# ============================================
# AMBIENTE
# ============================================
# Ambiente: development, production, test
NODE_ENV=production

# ============================================
# REDE (Docker)
# ============================================
# Necessário em Docker: o container não enxerga o IP real da LAN do host,
# só a rede virtual interna do Docker. Sem isso, a URL de LAN anunciada
# pelo app fica errada e o acesso via celular/outros dispositivos quebra.
# Descubra o IP com `ipconfig` (Windows) e use o adaptador Ethernet/Wi-Fi real.
HOST_LAN_IP=192.168.1.100

# ============================================
# MONTAGEM DE PASTAS (helper no host)
# ============================================
# Token compartilhado entre o container e o helper em host-helper/.
# Gerado por `drivelocal-helper.exe init` (scripts/install-mount-helper.bat).
# Não commite o valor real.
# MOUNT_HELPER_TOKEN=

# ============================================
# BIBLIOTECA / IA LOCAL (agent-hub)
# ============================================
# Endpoint OpenAI-compatível do agent-hub (llama-swap) rodando no host.
# A IA só roda dentro de AI_WINDOW. Sugestões com confiança >= AI_AUTO_ACCEPT
# são aplicadas sozinhas (com histórico e desfazer); o resto fica na fila de
# revisão. Maturidade sempre passa pela revisão. 0 desliga o aceite automático.
# AI_BASE_URL=http://host.docker.internal:8787/v1
# Mesma chave do HUB_API_KEY do agent-hub. Não commite o valor real.
# AI_API_KEY=
# Mesmo modelo para texto e visão evita troca de modelo na GPU a cada lote.
# AI_TEXT_MODEL=gemma4-12b-vision
# AI_VISION_MODEL=gemma4-12b-vision
# AI_WINDOW=01:00-08:00
# AI_TZ=America/Sao_Paulo
# AI_ENABLED=true
# AI_AUTO_ACCEPT=0.9

# ============================================
# METADADOS (opcional)
# ============================================
# Chave do TMDB (themoviedb.org → Configurações → API)
TMDB_API_KEY=
# Client ID do MyAnimeList (myanimelist.net/apiconfig → Create ID, tipo "other").
# Sem ele, a busca do MAL usa o Jikan, que nem sempre responde.
MAL_CLIENT_ID=
