{
  "name": "drivelocal-media-server",
  "version": "1.0.0",
  "description": "Local media server for video gallery and file management",
  "main": "server-go/main.go",
  "scripts": {
    "dev": "node scripts/dev.js",
    "prod": "node scripts/prod.js",
    "start": "cd server-go && go run .",
    "build": "cd client && npm run build",
    "build:server": "cd server-go && go build -o drivelocal-server.exe .",
    "build:all": "npm run build && npm run build:server",
    "docker:setup": "node scripts/docker-setup.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:status": "docker compose ps",
    "docker:restart": "docker compose restart",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:setup": "node scripts/test-setup.js",
    "test:functionality": "node scripts/test-functionality.js",
    "test:ui": "node scripts/test-ui.js",
    "test:all": "node scripts/test-all.js",
    "test:fixes": "node scripts/test-fixes.js",
    "test:video": "node scripts/test-video-fix.js",
    "test:checkbox": "node scripts/test-checkbox-position.js",
    "test:debug": "node scripts/test-server-debug.js",
    "test:encoding": "node scripts/test-path-encoding.js",
    "test:complete-fix": "node scripts/test-complete-fix.js",
    "install:ffmpeg": "node scripts/install-ffmpeg.js",
    "lint": "eslint server/ client/src/",
    "lint:fix": "eslint server/ client/src/ --fix",
    "kill-ports": "node scripts/kill-port.js 80 8080",
    "install:service": "node scripts/install-service.js",
    "configure:autostart": "node scripts/configure-autostart.js",
    "check:status": "node scripts/check-status.js",
    "test:complete": "node scripts/test-complete.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:all-suites": "npm test && npm run test:e2e",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "setup:env": "node setup-env.js",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jest": "^29.5.14",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jest": "^28.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "media",
    "server",
    "video",
    "gallery",
    "local"
  ],
  "author": "DriveLocal",
  "license": "MIT"
}
